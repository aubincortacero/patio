# Google Places API (New) — https://console.cloud.google.com/apis/library/places.googleapis.com
# Restreindre la clé à "Places API (New)" et à l'IP / au domaine du serveur.
NUXT_GOOGLE_PLACES_KEY=

# Optionnel : Place ID du restaurant (sinon retrouvé automatiquement)
# https://developers.google.com/maps/documentation/places/web-service/place-id
NUXT_GOOGLE_PLACE_ID=
